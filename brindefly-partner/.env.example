# URL pública deste site (sem barra no fim). Usada em metadataBase.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# client-api da Veforma (navegador fala direto com ela; `pnpm kb:generate` também lê daqui). Homologação:
NEXT_PUBLIC_VEFORMA_CLIENT_API_URL=https://api-client-hml.veforma.com.br

# Desenvolvimento local: a hml só libera CORS para https://brindefly-hml.veforma.com.br.
# Para rodar em localhost, aponte a URL pública para o proxy do Next e informe o alvo:
# NEXT_PUBLIC_VEFORMA_CLIENT_API_URL=http://localhost:3000/veforma-api
# VEFORMA_CLIENT_API_PROXY_TARGET=https://api-client-hml.veforma.com.br

# Painel da Brindefly, usado só como link de saída quando a conexão já terminou.
NEXT_PUBLIC_BRINDEFLY_PANEL_URL=http://localhost:5173
